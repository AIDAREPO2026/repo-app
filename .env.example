# Copy to .env at the repository root and fill in. Never commit .env.
# The app reads the first six (app/core/config.py) and will not start without them.
# The values below suit the Docker Compose stack (deploy/docker-compose.yml).

# local, staging or production
APP_ENV=local
# Must use the same user, password and database as the POSTGRES_ values below.
DATABASE_URL=postgresql+psycopg://aida:change-me@postgres:5432/aida
REDIS_URL=redis://redis:6379/0
# Signs sessions and CSRF tokens. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
# Encrypts TOTP secrets. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me
# Salts the hashed IP addresses in activity logs. Generate like SECRET_KEY.
IP_HASH_SALT=change-me

# Read by the postgres container to create the database on first start.
POSTGRES_USER=aida
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aida

# File storage (D-14). Read by the seaweedfs and tusd containers now, and by the
# app's storage module later. SeaweedFS accepts only requests signed with these keys.
S3_ENDPOINT_URL=http://seaweedfs:8333
S3_BUCKET=aida
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
AWS_REGION=ap-south-1
